ess : TEXT&lt;br&gt;courier : VARCHAR&lt;br&gt;shipping_cost : BIGINT&lt;br&gt;subtotal : BIGINT&lt;br&gt;status : VARCHAR&lt;br&gt;UK (transaction_id, store_id)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="transaction"><mxGeometry x="70" y="450" width="330" height="356" as="geometry" /></mxCell><mxCell id="transaction_items" value="&lt;div style=&quot;font-family:Arial;font-size:14px&quot;&gt;&lt;div style=&quot;background-color:#1e293b;color:#ffffff;padding:10px;font-weight:bold;font-size:16px&quot;&gt;transaction_items&lt;/div&gt;&lt;div style=&quot;padding:8px;line-height:23px;text-align:left&quot;&gt;id : UUID [PK]&lt;br&gt;transaction_order_id : UUID [FK]&lt;br&gt;variant_id : UUID [REF]&lt;br&gt;product_name_snapshot : VARCHAR&lt;br&gt;variant_name_snapshot : VARCHAR&lt;br&gt;unit_price : BIGINT&lt;br&gt;quantity : INTEGER&lt;br&gt;line_total : BIGINT&lt;br&gt;note : TEXT&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="transaction"><mxGeometry x="70" y="1040" width="330" height="264" as="geometry" /></mxCell><mxCell id="rel1" value="1 : 0..N | store_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#475569;dashed=0;strokeWidth=1.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;jettySize=auto;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stores" target="products"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel2" value="1 : 0..N | product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#475569;dashed=0;strokeWidth=1.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;jettySize=auto;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="products" target="product_variants"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel3" value="1 : 0..N | cart_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#475569;dashed=0;strokeWidth=1.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;jettySize=auto;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="carts" target="cart_items"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel4" value="1 : 0..N | transaction_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#475569;dashed=0;strokeWidth=1.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;jettySize=auto;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="transactions" target="transaction_orders"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel5" value="1 : 0..N | transaction_order_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#475569;dashed=0;strokeWidth=1.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;jettySize=auto;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="transaction_orders" target="transaction_items"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel6" value="REF 1 : 0..N | variant_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#2563eb;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;jettySize=auto;exitX=1;exitY=0.3;entryX=0;entryY=0.6;" edge="1" parent="1" source="product_variants" target="cart_items"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="1089" /><mxPoint x="570" y="797" /></Array></mxGeometry></mxCell><mxCell id="rel7" value="REF 1 : 0..N | store_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#2563eb;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;jettySize=auto;exitX=1;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="stores" target="transaction_orders"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="308" /><mxPoint x="535" y="140" /><mxPoint x="1790" y="140" /><mxPoint x="1790" y="737" /></Array></mxGeometry></mxCell><mxCell id="rel8" value="REF 1 : 0..N | variant_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#2563eb;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;jettySize=auto;exitX=1;exitY=0.8;entryX=0;entryY=0.65;" edge="1" parent="1" source="product_variants" target="transaction_items"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="1190" /><mxPoint x="600" y="1550" /><mxPoint x="1190" y="1550" /><mxPoint x="1190" y="1392" /></Array></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;DESAIN DATABASE E-COMMERCE&lt;/b&gt;&lt;br&gt;3 microservices | 8 tabel | Katalog → Detail produk → Keranjang → Checkout → Daftar dan detail transaksi" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=23;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1730" height="85" as="geometry"/></mxCell><mxCell id="cart_note" value="&lt;b&gt;Identitas pelanggan&lt;/b&gt;&lt;br&gt;customer_id mengacu ke sistem autentikasi/profil yang diasumsikan sudah tersedia di luar cakupan soal. Karena itu, tabel pelanggan tidak ditampilkan.&lt;br&gt;&lt;br&gt;&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;Item terpilih disalin ke transaksi, dikelompokkan per toko. Harga dan stok divalidasi kembali melalui Catalog Service. Setelah berhasil, item terpilih dihapus dari keranjang.&lt;br&gt;&lt;br&gt;&lt;b&gt;Riwayat transaksi&lt;/b&gt;&lt;br&gt;Nama produk, varian, toko, harga, dan alamat disimpan saat checkout agar perubahan data asal tidak mengubah riwayat." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="705" y="1110" width="355" height="355" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;NOTASI DAN RELASI&lt;/b&gt;&lt;br&gt;PK = primary key | FK = foreign key dalam service | UK = unique key | REF = referensi lintas service.&lt;br&gt;Garis utuh abu-abu: relasi FK lokal. Garis putus-putus biru: referensi logis melalui API, tanpa FK lintas database.&lt;br&gt;1 : 0..N berarti satu record induk dapat direferensikan nol atau banyak record anak; setiap anak mengacu tepat ke satu induk.&lt;br&gt;Produk aktif wajib memiliki minimal satu varian. Transaksi checkout yang valid wajib memiliki pesanan dan setiap pesanan wajib memiliki item." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="1650" width="1750" height="150" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;ATURAN UTAMA&lt;/b&gt;&lt;br&gt;quantity &amp;gt; 0; stock &amp;gt;= 0; nilai uang BIGINT dalam rupiah dan tidak negatif.&lt;br&gt;line_total = unit_price × quantity; subtotal = jumlah line_total per toko; total_amount = jumlah (subtotal + shipping_cost) seluruh pesanan.&lt;br&gt;Satu checkout dapat berisi beberapa toko; UNIQUE(transaction_id, store_id) memastikan satu pesanan per toko.&lt;br&gt;Satu keranjang aktif per pelanggan. Satu produk tanpa pilihan tetap memiliki satu varian default.&lt;br&gt;Data produk/toko yang sudah direferensikan transaksi tidak dihapus permanen; penghapusan logis dapat ditambahkan saat implementasi." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="1820" width="1750" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>